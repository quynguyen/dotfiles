.stow-packages/nvim/.config/nvim/plugin/packer_compiled.lua
.stow-packages/lazygit/.config/lazygit/state.yml
.stow-packages/tmux/.tmux/plugins/extrakto
# ...except the global one, which is config worth versioning. Without this
# negation `pre-opus5-reset` silently omitted it and the rollback tag was
# incomplete.
!.stow-packages/llm/.claude/CLAUDE.md
# ...and archived copies of it, which exist precisely to survive this rule.
!.stow-packages/llm/.claude/ablate/archive/**/CLAUDE.md
.claude/settings.local.json
.stow-packages/zsh/.zsh/private_exports

# gstack — tool-managed git repo, too large to track. These are checkouts of a
# separate repo; committing them as bare gitlinks (no .gitmodules entry) breaks
# every `git submodule update`, which is what the stale claude-code/ path below
# let happen after the package was renamed to llm/.
.stow-packages/llm/.claude/skills/gstack/
.stow-packages/llm/.claude.bak/skills/gstack/
.stow-packages/llm/.agents/skills/gstack/

# Claude Code writes machine-local synced skills through the ~/.claude/skills symlink
.stow-packages/llm/.claude/skills/synced/

# ablate: generated config profiles and run outputs
.stow-packages/llm/.claude/ablate/results/
