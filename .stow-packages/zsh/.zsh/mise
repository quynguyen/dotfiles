# mise — polyglot version manager (Ruby, Node, etc.)
# Shims dir is added directly to PATH (front) so mise-managed tools
# take priority over Homebrew. This runs before brew shellenv loads,
# so we can't rely on `command -v mise` here.
if [[ -d "$HOME/.local/share/mise/shims" ]]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
