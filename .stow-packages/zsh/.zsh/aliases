# vim: set ft=zsh

# Aliases
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ls="ls --color=auto"
alias ll="ls -al"
alias l="ll"
alias lg="lazygit"
alias c="yazicd"
alias cl="clear"
alias n="nvim"
alias cat="bat"
alias mux="tmuxinator"
alias nz="nvim ~/.zshrc"
alias na="nvim ~/.zsh/aliases"
alias nb="nvim ~/.zsh/bindings"
alias nn="nvim ~/.config/nvim/init.lua"
alias nx="nvim ~/dotfiles/.scripts/nix/install-nix-packages.sh"
alias ez="exec zsh"
alias gs="git status"
alias gcm="git checkout main"
alias gpr="git pull --rebase"
alias log="git log --oneline --decorate --graph"
alias dbp="dev cd business-platform"
alias dshop="dev cd shopify"
alias dweb="dev cd web"
alias dbo="dev cd bourgeois"
alias claude="~/.local/bin/claude"
alias python="python3"
alias pip="pip3"
alias wl="wt list"
alias wm="wt merge"
alias ws="wt switch"
alias wr="wt remove"
alias cc="claude --dangerously-skip-permissions"

# Give non-macOS shells the pbcopy/pbpaste names, routed through ~/.bin/xcopy
# and ~/.bin/xpaste. Those scripts already pick between wl-copy, xclip and xsel
# (and tmux's copy-mode bindings go through xcopy too), so the selection logic
# lives in exactly one place. They also degrade to a readable message over SSH
# with no display, where calling wl-copy directly just fails to connect.
if [[ `uname` != "Darwin" ]]; then
	alias pbcopy='xcopy'
	alias pbpaste='xpaste'
fi
