#!/bin/bash

# Shell switcher - shows the command to switch to configured shell
# Note: Cannot automatically change shell from script - user must run the command

DOTFILES_PATH="${DOTFILES_PATH:-$HOME/dotfiles}"
SHELL_CONFIG_FILE="$DOTFILES_PATH/.stow-packages/shell/.shell_config"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Get current shell mode
if [[ -f "$SHELL_CONFIG_FILE" ]]; then
    DOTFILES_SHELL_MODE=$(grep "^DOTFILES_SHELL_MODE=" "$SHELL_CONFIG_FILE" | cut -d'=' -f2 | tr -d '"')
else
    DOTFILES_SHELL_MODE="zsh-p10k"
fi

echo -e "${BLUE}Current configuration:${NC} $DOTFILES_SHELL_MODE"
echo -e "${BLUE}To switch to this shell, run:${NC}"

case "$DOTFILES_SHELL_MODE" in
    "fish")
        echo -e "${YELLOW}fish${NC}"
        ;;
    "nushell")
        echo -e "${YELLOW}nu${NC}"
        ;;
    "zsh-p10k"|"zsh-starship"|*)
        echo -e "${YELLOW}zsh${NC}"
        ;;
esac

echo -e "${BLUE}(Cannot automatically change shell from script)${NC}"