#!/bin/sh

# Cross-platform clipboard copy (stdin -> system clipboard)
if command -v pbcopy >/dev/null 2>&1; then
  pbcopy  # macOS
elif command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  wl-copy  # Linux / Wayland (Omarchy)
elif command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard  # Linux / X11 (preferred)
elif command -v xsel >/dev/null 2>&1; then
  xsel -i -b  # Linux / X11 (fallback)
elif command -v clip.exe >/dev/null 2>&1; then
  clip.exe  # Windows
else
  cat  # Fallback: output to stdout if no clipboard available
fi
