#!/bin/bash

# Shell mode checker - displays the current shell configuration mode

DOTFILES_PATH="${DOTFILES_PATH:-$HOME/dotfiles}"
SHELL_CONFIG_FILE="$DOTFILES_PATH/.stow-packages/shell/.shell_config"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to get current shell mode from config
get_current_mode() {
    if [[ -f "$SHELL_CONFIG_FILE" ]]; then
        grep "^DOTFILES_SHELL_MODE=" "$SHELL_CONFIG_FILE" | cut -d'=' -f2 | tr -d '"'
    else
        echo "zsh-p10k"
    fi
}

# Function to get description for a mode
get_mode_description() {
    local mode="$1"
    case "$mode" in
        "zsh-p10k")
            echo "Zsh with Powerlevel10k (default)"
            ;;
        "zsh-starship")
            echo "Zsh with Starship theme (modern, fast)"
            ;;
        "fish")
            echo "Fish shell (auto-suggestions, fast)"
            ;;
        "nushell")
            echo "Nushell (structured data shell)"
            ;;
        *)
            echo "Unknown mode"
            ;;
    esac
}

# Main function
main() {
    local current_mode
    current_mode=$(get_current_mode)
    local description
    description=$(get_mode_description "$current_mode")
    
    echo -e "${GREEN}Current shell mode:${NC} ${BLUE}$current_mode${NC}"
    echo -e "${GREEN}Description:${NC} $description"
    
    # Show both SHELL env var and actual running process
    if [[ -n "$SHELL" ]]; then
        echo -e "${GREEN}SHELL variable:${NC} $SHELL"
    fi
    
    # Try to detect actual running shell
    local actual_shell="unknown"
    if command -v ps &> /dev/null; then
        # Get the parent process (the shell running this script)
        local parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [[ -n "$parent_pid" ]]; then
            actual_shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null || echo "unknown")
        fi
    fi
    
    # Fallback to checking SHELL variable if we can't detect
    if [[ "$actual_shell" == "unknown" && -n "$SHELL" ]]; then
        actual_shell="$SHELL"
    fi
    
    echo -e "${GREEN}Running shell:${NC} $actual_shell"
    
    # Show if there's a mismatch between config and running shell
    case "$current_mode" in
        "fish")
            if [[ "$actual_shell" != *"fish"* ]]; then
                echo -e "${YELLOW}⚠️  Note: Configuration is set to fish but you're running $actual_shell${NC}"
            fi
            ;;
        "nushell")
            if [[ "$actual_shell" != *"nu"* ]]; then
                echo -e "${YELLOW}⚠️  Note: Configuration is set to nushell but you're running $actual_shell${NC}"
            fi
            ;;
        "zsh-p10k"|"zsh-starship")
            if [[ "$actual_shell" != *"zsh"* ]]; then
                echo -e "${YELLOW}⚠️  Note: Configuration is set to $current_mode but you're running $actual_shell${NC}"
            fi
            ;;
    esac
}

main "$@"