{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  },
  "general": {
    "preferredEditor": "vim",
    "previewFeatures": true,
    "vimMode": true,
    "debugKeystrokeLogging": true,
    "enablePromptCompletion": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "warningAcknowledged": true
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    },
    "folderTrust": {
      "enabled": true
    }
  },
  "ui": {
    "theme": "Dracula",
    "showStatusInTitle": true,
    "showMemoryUsage": true,
    "showLineNumbers": true,
    "showCitations": true,
    "useFullWidth": true
  },
  "output": {
    "format": "text"
  },
  "tools": {
    "autoAccept": true
  },
  "ide": {
    "enabled": true
  }
}