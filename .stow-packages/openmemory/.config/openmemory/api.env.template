# OpenMemory API Environment Configuration
# Copy this file to api.env and fill in your actual values

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# User ID for memory persistence (can be any unique identifier)
USER=your-unique-user-id

# Optional: OpenMemory API settings
# MEM0_API_KEY=your-mem0-api-key (if using hosted service)
# DATABASE_URL=postgresql://user:pass@localhost:5432/openmemory (if using custom database)